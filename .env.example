# Free key from https://carto.com/basemaps/apikey/ — leave blank to
# fall back to OpenStreetMap tiles (no key required).
CARTO_API_KEY=

# Free key from https://console.groq.com/keys (email signup, no card) —
# enables the "Generate plan" button. Leave blank to disable.
GROQ_API_KEY=
# Optional: override the Groq model (default openai/gpt-oss-120b).
# GROQ_MODEL=

# Only needed by scripts/import-practices.js when rows lack coordinates.
# Nominatim requires an identifying contact (email or URL) in the User-Agent.
NOMINATIM_CONTACT=
